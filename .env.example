# انسخ الملف ده باسم .env واملا القيم. ملف .env مش بيترفع ولا بيدخل صورة Docker.
PG_PASSWORD=ضع-كلمة-مرور-قوية-لقاعدة-البيانات
# مفتاح طويل عشوائي، تقدر تولّده بـ: python -c "import secrets; print(secrets.token_urlsafe(50))"
VEYRA_SECRET_KEY=ضع-مفتاح-عشوائي-طويل
VEYRA_HOSTS=localhost,127.0.0.1
# لما تنشر خلف HTTPS: حط الدومين هنا (مع https://) وفعّل VEYRA_HTTPS=1
# VEYRA_CSRF_ORIGINS=https://erp.example.com
# VEYRA_HTTPS=1
